{
  "name": "debuggig-tools",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=11.5.1"
  },
  "workspaces": [
    "packages/*",
    "packages/debug-gui/protocol",
    "packages/debug-gui/server",
    "packages/debug-gui/web"
  ],
  "devDependencies": {
    "mocha": "^11.0.0",
    "webdriverio": "^9.0.0"
  },
  "mocha": {
    "require": [
      "./test/walkthrough-e2e-wdio/wdio-setup.js"
    ],
    "timeout": 0
  },
  "debug-gui": {
    "discovery": {
      "globs": [
        "test/walkthrough-e2e-wdio/*.spec.js",
        "test/ui-fixtures/*.spec.js"
      ]
    },
    "agent": {
      "mode": "manual"
    }
  }
}
